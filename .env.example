# Melon 쿠키 인증
# 멜론 웹사이트(www.melon.com) 로그인 후 브라우저 개발자 도구(F12) → Application → Cookies 에서 복사
# 예: MELON_COOKIE=__T_=...; MAC=...; keyCookie=...; MLCP=...
MELON_COOKIE=your_full_melon_cookie_string_here

# Melon 회원 키 (keyCookie 값과 동일)
# Cookies 목록에서 keyCookie 항목의 값을 복사하세요
MELON_MEMBER_KEY=your_member_key_here
